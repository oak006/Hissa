<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+). Without this, launchers treat the legacy square
     icon as a foreground and drop it on a white background layer, which is
     where the white circle came from. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/hissa_navy" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
