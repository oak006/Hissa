<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ ignores windowBackground for the launch screen and draws its
         own splash from these. windowSplashScreenIconBackgroundColor is left
         unset on purpose: with no icon plate, the white mark sits straight on
         the navy instead of inside a white circle. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/hissa_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/hissa_bg</item>
    </style>
</resources>
